      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.24.1-preview.1" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.18.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AppleAcademy.Application\AppleAcademy.Application.csproj" />
    <ProjectReference Include="..\AppleAcademy.Infrastructure\AppleAcademy.Infrastructure.csproj" />
  </ItemGroup>

</Project>
